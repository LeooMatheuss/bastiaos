# BastiaOS BusyBox Configuration
# Minimal but functional configuration for BastiaOS

CONFIG_HAVE_DOT_CONFIG=y

# General Configuration
CONFIG_DESKTOP=y
CONFIG_EXTRA_COMPAT=y
CONFIG_INCLUDE_SUSv2=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LFS=y
CONFIG_PAM=y
CONFIG_FEATURE_DEVFS=y
CONFIG_FEATURE_UTMP=y
CONFIG_FEATURE_WTMP=y
CONFIG_FEATURE_PIDFILE=y
CONFIG_PID_FILE_PATH="/var/run"
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SHOW_SCHEMA=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_NO_USR=y
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SUID_CONFIG=y
CONFIG_FEATURE_SUID_CONFIG_QUIET=y
CONFIG_SELINUX=y
CONFIG_FEATURE_CLEAN_UP=y
CONFIG_FEATURE_SYSLOG=y
CONFIG_PLATFORM_LINUX=y

# Build Options
CONFIG_STATIC=y
CONFIG_PIE=y
CONFIG_NOMMU=y
CONFIG_BUILD_LIBBUSYBOX=y
CONFIG_FEATURE_INDIVIDUAL=y
CONFIG_FEATURE_SHARED_BUSYBOX=y
CONFIG_LFS=y

# Busybox Library Tuning
CONFIG_FEATURE_SYSTEMD=y
CONFIG_FEATURE_RT_MINMAX=y
CONFIG_PASSWORD_MINLEN=6
CONFIG_MD5_SMALL=y
CONFIG_SHA3_SMALL=y
CONFIG_FEATURE_FAST_TOP=y
CONFIG_FEATURE_ETC_NETWORKS=y
CONFIG_FEATURE_USE_TERMIOS=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_VI=y
CONFIG_FEATURE_EDITING_HISTORY=256
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_RELOAD_SIGHUP=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_TAB_COMPLETION_FILE=y
CONFIG_FEATURE_TAB_COMPLETION_DIR=y
CONFIG_FEATURE_TAB_COMPLETION_FANCY_PROMPT=y
CONFIG_FEATURE_USERNAME_COMPLETION=y
CONFIG_FEATURE_CHOWN_ON_CHMOD=y
